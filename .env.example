# Port and Environment
PORT=3001
NODE_ENV=development

# Auth bypass (development only)
# Set to 'true' to skip authentication/JWT validation during local development. When enabled,
# the app uses TP_CONTACT_EMAIL as the user identity instead of verifying JWT.
# This is ignored in production (NODE_ENV !== 'development').
BYPASS_AUTH=false

# JWT Authentication Configuration
# Generate a secure random JWT secret key (minimum 32 characters suggested)
JWT_SECRET='super-secret-jwt-key-for-broker-automation-32bytes!'
FRONTEND_BASE_URL='http://localhost:3000'
BACKEND_BASE_URL='http://localhost:3001'

# Meta / Facebook Configuration
# Get these values from the Meta Developer Dashboard: https://developers.facebook.com/apps/
FB_APP_ID='your-facebook-app-id'
FB_APP_SECRET='your-facebook-app-secret'
FB_GRAPH_API_VERSION='v22.0'
FB_REG_PIN='your-registration-pin'
FB_VERIFY_TOKEN='your-webhook-verify-token'

# Frontend Specific (WhatsApp Embedded Signup)
BACKEND_URL='http://localhost:3001'
NEXT_PUBLIC_FB_APP_ID='your-facebook-app-id'
NEXT_PUBLIC_FB_CONFIG_ID='your-embedded-signup-config-id'

# Redis Configuration
REDIS_URL='redis://localhost:6379'

# Contact Information
TP_CONTACT_EMAIL='your-contact-email@example.com'

# Database (auto-configured when using Vercel + Neon integration)
POSTGRES_URL='postgres://user:password@localhost:5432/database'

# GCP Vertex AI Configuration (for Gemini Auto-Reply Agent using GCP credentials)
GCP_PROJECT_ID='your-gcp-project-id'
GCP_LOCATION='us-central1'
# Optional: absolute path to your GCP service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=''
# Optional: inline service account JSON key contents (stringified JSON on a single line)
GCP_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "your-gcp-project-id", "private_key": "-----BEGIN PRIVATE KEY-----\\n...", "client_email": "your-service-account@your-gcp-project-id.iam.gserviceaccount.com"}'

# Note: Copy this file to .env.local and replace the placeholder values with your actual secrets.
# Never commit .env.local to version control.

# AWS S3 Image Storage
# Create an S3 bucket and IAM user with PutObject + DeleteObject permissions on that bucket.
# Set the bucket ACL to public-read (or use CloudFront) so uploaded image URLs are publicly accessible.
AWS_REGION='ap-south-1'
AWS_ACCESS_KEY_ID='your-aws-access-key-id'
AWS_SECRET_ACCESS_KEY='your-aws-secret-access-key'
AWS_S3_BUCKET='your-s3-bucket-name'
# Base public URL for the bucket. No trailing slash.
# Example: https://your-bucket.s3.ap-south-1.amazonaws.com
# Or your CloudFront distribution URL: https://xxxxx.cloudfront.net
AWS_S3_PUBLIC_URL='https://your-bucket.s3.ap-south-1.amazonaws.com'

# Cashfree Configuration
CASHFREE_APP_ID='your-cashfree-app-id'
CASHFREE_SECRET_KEY='your-cashfree-secret-key'
CASHFREE_ENV='sandbox'

